<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pos_mx_entrega_valores_wizard" model="ir.ui.view">
        <field name="name">view.pos_mx.entrega_valores.wizard</field>
        <field name="model">pos_mx.reporte_entrega_valores.wizard</field>
        <field name="arch" type="xml">
            <form string="Reporte de entrega de valores">
                <group>
                    <field name="tienda_id"/>
                    <field name="fecha_inicio"/>
                    <field name="fecha_fin"/>
                </group>
                <footer>
                    <button name="print_report" string="Generar reporte" type="object" class="oe_highlight"/>
                    <button string="Cancelar" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="pos_mx_action_reporte_entrega_valores" model="ir.actions.act_window">
        <field name="name">Reporte de entrega de valores</field>
        <field name="res_model">pos_mx.reporte_entrega_valores.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_entrega_valores"
              parent="point_of_sale.menu_point_rep"
              action="pos_mx_action_reporte_entrega_valores"/>
</odoo>